{
  "name": "react-semantic-tree",
  "version": "0.1.1",
  "description": "Decorate your React component tree with semantic context.",
  "workspaces": [
    "example"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run format:check && npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "logging",
    "semantic-tree",
    "context",
    "sentry",
    "logrocket",
    "typescript"
  ],
  "author": "GregorShear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregorShear/react-semantic-tree.git"
  },
  "homepage": "https://github.com/GregorShear/react-semantic-tree#readme",
  "bugs": {
    "url": "https://github.com/GregorShear/react-semantic-tree/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
